# ──────────────────────────────────────────────────────────────────────────────
# SMTP — отправка писем с формы контактов / RFQ-корзины через Yandex 360.
# ──────────────────────────────────────────────────────────────────────────────
# 1. На id.yandex.ru/security/app-passwords создаём «Пароль приложения» типа
#    «Почта» → копируем 16-значный пароль ниже в SMTP_PASS.
# 2. В настройках Яндекс.Почты убедиться, что включено:
#    «Все настройки → Почтовые программы → Разрешить доступ к ящику с помощью
#    почтовых клиентов по протоколу IMAP/SMTP, по паролю приложения».
# Документация: https://yandex.com/support/yandex-360/customers/mail/ru/web/mail-clients

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=med@viena.by
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_SECURE=true

# Кому приходят заявки (по умолчанию равно SMTP_USER).
CONTACT_TO_EMAIL=med@viena.by

# Имя отправителя в шапке письма (адрес всегда = SMTP_USER, иначе Яндекс
# отвергнет письмо).
CONTACT_FROM_NAME=VIENA — заявки с сайта

# Публичный URL сайта — используется для canonical / hreflang / OpenGraph.
NEXT_PUBLIC_SITE_URL=https://viena.by

# ──────────────────────────────────────────────────────────────────────────────
# Аналитика и поисковые вебмастеры. Все переменные опциональные:
# скрипт/тег подключается только если переменная задана.
# ──────────────────────────────────────────────────────────────────────────────

# Yandex Metrika — счётчик ID (8 цифр).
# Создать: https://metrika.yandex.ru/list — счётчик → ID.
# NEXT_PUBLIC_YM_ID=99999999

# Google Tag Manager — ID контейнера (формат GTM-XXXXXX).
# Создать: https://tagmanager.google.com → Container → ID.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Подтверждение прав в поисковых вебмастерах.
# Yandex.Webmaster → «Добавить сайт» → метод «META-тег» → скопировать значение
# из <meta name="yandex-verification" content="…">.
# NEXT_PUBLIC_YANDEX_VERIFICATION=abcdef0123456789

# Google Search Console → «Добавить ресурс» → «HTML-тег» → значение content="…".
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=abcdef0123456789

# Bing Webmaster Tools → «Добавить сайт» → «HTML Meta Tag» → значение content.
# NEXT_PUBLIC_BING_VERIFICATION=ABCDEF1234567890
