# Resend transactional email — used by /api/contact for the RFQ form.
# Sign up at https://resend.com and create an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where the contact form submissions are delivered.
CONTACT_TO_EMAIL=med@viena.by

# "From" address shown to recipients. Use a verified domain on Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Optional fallback Reply-To when the user hasn't filled in their email.
CONTACT_REPLY_TO=med@viena.by

# Public site URL — used for canonical / hreflang / OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=https://viena.by
